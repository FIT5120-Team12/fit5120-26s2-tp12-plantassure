<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot Parent：
        统一管理常见依赖版本、Maven 插件默认配置以及 Java 编译相关设置。
        使用 parent 后，Spring Web/Test 等依赖一般不需要自己填写版本号。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <!-- 当前项目 Maven 坐标。 -->
    <groupId>com.plantky</groupId>
    <artifactId>plantky-backend</artifactId>
    <version>1.0.0</version>
    <name>plantky-backend</name>
    <description>Plantky Iteration 1 backend for FIT5120 Project 2</description>

    <properties>
        <!-- Spring Boot 3.x 最低要求 Java 17；本项目统一使用 Java 17。 -->
        <java.version>17</java.version>

        <!-- 单独声明第三方依赖版本，升级时只改一个地方。 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencies>
        <!--
            Spring MVC / REST API / 内嵌 Tomcat / Jackson JSON。
            Controller、@RestController、@GetMapping 等来自这一 Starter。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Jakarta Bean Validation。
            当前用于 @Positive 等参数校验。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            MyBatis-Plus Spring Boot 3 Starter。
            提供 BaseMapper、LambdaQueryWrapper、Entity 映射等能力。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--
            MySQL JDBC Driver。
            runtime 表示编译业务代码时不需要直接依赖其 API，但应用运行时必须存在。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            OpenAPI / Swagger UI。
            Springdoc 会扫描 Controller 生成 /v3/api-docs，Apifox 可直接导入。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
            Lombok：通过编译期代码生成减少样板代码。
            当前项目使用 @Getter、@Data、@Builder、@RequiredArgsConstructor、@Slf4j 等。
            optional=true 表示依赖该项目的其他项目不需要自动继承 Lombok。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试 Starter：JUnit 5、Mockito、AssertJ、Spring Test、MockMvc 等。
            scope=test 表示不会打进生产运行包。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Spring Boot Maven Plugin：
                支持 mvn spring-boot:run、构建可执行 fat jar 等。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
